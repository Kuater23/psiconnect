rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }

    // Check if requester is a doctor user in Firestore
    function isProfessional() {
      return isSignedIn() &&
             exists(/databases/(default)/documents/doctors/$(request.auth.uid));
    }

    // doctor_patients/{doctorId_patientId}
    function hasRelation(patientId) {
      return isSignedIn() &&
             patientId != null &&
             exists(/databases/(default)/documents/doctor_patients/$(request.auth.uid + '_' + patientId));
    }

    // All else denied by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Objects are stored under patient_documents/{patientId}/{fileName}
    match /patient_documents/{patientId}/{fileName} {
      allow read, write, delete: if isProfessional() && hasRelation(patientId);
    }

    // Keep your public images as before (optional)
    match /images/{imageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /images/{folder}/{imageId} { allow read: if true; }
  }
}